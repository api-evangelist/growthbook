          "http": {
            "method": "DELETE",
            "url": "https://api.growthbook.io/api/v2/features/:id/revisions/:version/rules/:ruleId",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              },
              {
                "name": "version",
                "value": "",
                "type": "path"
              },
              {
                "name": "ruleId",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Removes the rule from the revision. Any pending ramp actions for this rule are also cleared."
        },
        {
          "info": {
            "name": "Reorder rules in the revision",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.growthbook.io/api/v2/features/:id/revisions/:version/rules/reorder",
