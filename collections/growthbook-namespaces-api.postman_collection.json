      "id": "04ec640f-e996-4874-bda3-45c150c9dcfa",
      "name": "namespaces",
      "description": {
        "content": "Namespaces partition your user population into buckets so that experiments using the same hash attribute do not overlap unintentionally. Each namespace defines a 0–1 range and individual experiments claim sub-ranges within it.",
        "type": "text/plain"
      },
