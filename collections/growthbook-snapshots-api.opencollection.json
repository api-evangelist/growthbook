{
  "opencollection": "1.0.0",
  "info": {
    "name": "GrowthBook REST AnalyticsExplorations snapshots API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "snapshots",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Create Experiment Snapshot",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.growthbook.io/api/v1/experiments/:id/snapshot",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "The experiment id of the experiment to update"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create Experiment Snapshot"
        },
        {
          "info": {
            "name": "Get an experiment snapshot status",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.growthbook.io/api/v1/snapshots/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "The id of the requested resource (a snapshot ID, not experiment ID)"
              }
            ]
          },
          "docs": "Get an experiment snapshot status"
        }
      ]
    }
  ],
  "bundled": true
}