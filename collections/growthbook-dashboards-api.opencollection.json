{
  "opencollection": "1.0.0",
  "info": {
    "name": "GrowthBook REST AnalyticsExplorations Dashboards API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Dashboards",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get a single dashboard",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.growthbook.io/api/v1/dashboards/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Get a single dashboard"
        },
        {
          "info": {
            "name": "Update a single dashboard",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://api.growthbook.io/api/v1/dashboards/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Update a single dashboard"
        },
        {
          "info": {
            "name": "Delete a single dashboard",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.growthbook.io/api/v1/dashboards/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Delete a single dashboard"
        },
        {
          "info": {
            "name": "Get all dashboards",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.growthbook.io/api/v1/dashboards"
          },
          "docs": "Get all dashboards"
        },
        {
          "info": {
            "name": "Create a single dashboard",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.growthbook.io/api/v1/dashboards",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create a single dashboard"
        },
        {
          "info": {
            "name": "Get all dashboards for an experiment",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.growthbook.io/api/v1/dashboards/by-experiment/:experimentId",
            "params": [
              {
                "name": "experimentId",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Get all dashboards for an experiment"
        }
      ]
    }
  ],
  "bundled": true
}